{
  "name": "@tranmere-web/mcp",
  "description": "The simplest way to run a stateless MCP server on Cloudflare Workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "lint": "eslint .",
    "deploy": "yarn deploy:private",
    "deploy:private": "vite build && wrangler deploy",
    "deploy:public": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.public.jsonc vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tranmere-web/lib": "*",
    "agents": "*",
    "jose": "^6.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wrangler": "^4.118.0"
  }
}
