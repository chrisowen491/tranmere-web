{
  "name": "@tranmere-web/mcp",
  "description": "The simplest way to run a stateless MCP server on Cloudflare Workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "lint": "eslint .",
    "deploy": "yarn deploy:private",
    "deploy:private": "vite build && wrangler deploy",
    "deploy:public": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.public.jsonc vite build && wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false",
    "test": "yarn"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@tranmere-web/lib": "*",
    "agents": "*",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^5.20260925.2",
    "@types/node": "^26.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  }
}
