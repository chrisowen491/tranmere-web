{
  "name": "@tranmere-web/site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "site": "next dev --turbo -p 3001",
    "build": "next build",
    "test": "vitest run",
    "postbuild": "next-sitemap",
    "lint": "eslint .",
    "start": "next start",
    "format": "prettier --write \"app\" --write \"lib\" --write \"components\"",
    "cloudflare-build": "npx opennextjs-cloudflare build",
    "cloudflare-deploy": "npx opennextjs-cloudflare deploy",
    "cloudflare-deploy:staging": "npx opennextjs-cloudflare deploy --env staging",
    "db:migrate:staging": "npx wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "npx wrangler d1 migrations apply DB --remote",
    "cloudflare-preview": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db": "npx wrangler d1 execute tranmere-web --local --file=../sql/schema.sql ",
    "db:remote": "npx wrangler d1 execute tranmere-web --remote --file=../sql/schema.sql"
  },
  "author": "Chris Owen",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@auth0/auth0-react": "^2.22.1",
    "@auth0/nextjs-auth0": "^4.26.0",
    "@contentful/rich-text-html-renderer": "^17.0.0",
    "@contentful/rich-text-react-renderer": "^16.0.0",
    "@contentful/rich-text-types": "^17.0.0",
    "@datadog/browser-logs": "^7.7.0",
    "@datadog/browser-rum": "^7.7.0",
    "@headlessui/react": "^2.2.3",
    "@heroicons/react": "^2.1.4",
    "@material-tailwind/react": "^2.1.9",
    "@next/bundle-analyzer": "^16.3.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tranmere-web/lib": "*",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@use-gesture/react": "^10.3.1",
    "autoprefixer": "^10.5.4",
    "date-fns": "^4.0.0",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.2",
    "framer-motion": "^13.1.1",
    "next": "^16.3.2",
    "next-compose-plugins": "^2.2.1",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pdf-flipbook-viewer": "^0.2.0",
    "react-responsive-carousel": "^3.2.23",
    "react-spring": "^10.0.0",
    "recharts": "^3.1.2",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.11",
    "prettier": "^3.9.6",
    "tailwind-scrollbar": "^4.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.18",
    "wrangler": "^4.125.0"
  }
}
