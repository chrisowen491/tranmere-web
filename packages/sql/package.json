    "generate:goals": "node scripts/dynamodb-goals-to-d1.mjs",
    "generate:hat-tricks": "node scripts/dynamodb-hat-tricks-to-d1.mjs",
    "generate:managers": "node scripts/dynamodb-managers-to-d1.mjs",
    "generate:match-reports": "node scripts/dynamodb-match-reports-to-d1.mjs",
    "generate:players": "node scripts/dynamodb-players-to-d1.mjs",
    "generate:player-season-summaries": "node scripts/dynamodb-player-season-summaries-to-d1.mjs",
    "generate:transfers": "node scripts/dynamodb-transfers-to-d1.mjs",
    "migrations": "npx wrangler d1 migrations apply tranmere-web --local --persist-to=../site/.wrangler/state",
