{
  "name": "@tranmere-web/sql",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "db": "npx wrangler d1 execute tranmere-web --local --file=./schema.sql --persist-to=../site/.wrangler/state",
    "generate:clubs": "node scripts/dynamodb-clubs-to-d1.mjs",
    "generate:managers": "node scripts/dynamodb-managers-to-d1.mjs",
    "generate:players": "node scripts/dynamodb-players-to-d1.mjs",
    "generate:transfers": "node scripts/dynamodb-transfers-to-d1.mjs",
    "migrations": "npx wrangler d1 migrations apply tranmere-web --local --persist-to=../site/.wrangler/state",
    "lint": "yarn",
    "format": "yarn"
  },
